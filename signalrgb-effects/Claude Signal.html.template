<html>
<head>
<title>Claude Signal</title>
<meta description="Claude Signal: zeigt den Claude-Code-Status (liest state.txt selbst — keine Effektwechsel nötig)" />
<meta publisher="Claude Signal" />
</head>
<body style="margin:0;overflow:hidden;">
<canvas id="c" style="width:100%;height:100%;display:block"></canvas>
<script>
const cv = document.getElementById('c'), ctx = cv.getContext('2d');
cv.width = 320; cv.height = 200;

// install.sh ersetzt den Platzhalter unten durch den echten file://-Pfad von state.txt
const STATE_URL = '{{STATE_URL}}';
const POLL_MS = 600;    // Mindestabstand zwischen zwei XHR-Polls
const STALE_MS = 10000; // Overlay-Herzschlag aelter als das -> gray
const FADE_MS = 250;    // weicher Uebergang bei Zustandswechsel

let state = 'gray';
let epochMs = 0;
let lastPoll = 0;
let prevState = 'gray';
let changeAtMs = 0;

function poll() {
  try {
    const xhr = new XMLHttpRequest();
    xhr.open('GET', STATE_URL + '?nc=' + Date.now(), true);
    xhr.onload = function () {
      try {
        const text = (xhr.responseText || '').trim();
        const parts = text.split(/\s+/);
        if (parts.length < 2) { return; }              // kaputt: alten Zustand behalten
        const ts = parseInt(parts[1], 10);
        if (!isFinite(ts)) { return; }
        epochMs = ts;
        if (parts[0] !== state) {
          prevState = state;
          state = parts[0];
          changeAtMs = performance.now();
        }
      } catch (e) { /* kaputte Antwort: alten Zustand behalten */ }
    };
    xhr.onerror = function () { /* state.txt (noch) nicht lesbar: alten Zustand behalten */ };
    xhr.send();
  } catch (e) { }
}

// --- Zustands-Renderer: jeder fuellt den kompletten Canvas ---
function renderGray(t) {
  ctx.globalAlpha = 1;
  ctx.fillStyle = '#1050E0';
  ctx.fillRect(0, 0, cv.width, cv.height);
}
function renderGreen(t) {
  ctx.globalAlpha = 1;
  ctx.fillStyle = '#00D030';
  ctx.fillRect(0, 0, cv.width, cv.height);
}
function renderRed(t) {
  // arbeitet: blauer Lauf-/Atem-Puls (aus der frueheren "Claude Blau Puls")
  const phase = (t / 1400) % 1;                    // Wellenlauf ~1,4 s
  const breath = 0.65 + 0.35 * Math.sin(t / 900);   // sanftes Atmen
  const g = ctx.createLinearGradient(-cv.width + phase * 2 * cv.width, 0,
                                     phase * 2 * cv.width, 0);
  g.addColorStop(0.0, 'rgb(6,28,110)');
  g.addColorStop(0.5, 'rgb(40,120,255)');
  g.addColorStop(1.0, 'rgb(6,28,110)');
  ctx.globalAlpha = 1; ctx.fillStyle = '#04123c'; ctx.fillRect(0, 0, cv.width, cv.height);
  ctx.fillStyle = g; ctx.globalAlpha = Math.max(0.35, breath);
  ctx.fillRect(0, 0, cv.width, cv.height);
}
function renderYellow(t) {
  // wartet auf dich: kraeftiges rotes Pulsieren (aus der frueheren "Claude Rot Puls")
  const k = 0.5 + 0.5 * Math.sin(t / 127);   // kraeftiger Puls ~0,8 s
  const r = Math.round(60 + 195 * k);
  ctx.globalAlpha = 1;
  ctx.fillStyle = 'rgb(' + r + ',0,0)';
  ctx.fillRect(0, 0, cv.width, cv.height);
}
function renderYellowbusy(t) {
  // wartet + Hintergrund arbeitet: schnelleres rotes Laufen (aus der frueheren "Claude Rot Lauf")
  const phase = (t / 1000) % 1;                     // Alarmlauf ~1,0 s
  const g = ctx.createLinearGradient(-cv.width + phase * 2 * cv.width, 0,
                                     phase * 2 * cv.width, 0);
  g.addColorStop(0.0, 'rgb(100,4,4)');
  g.addColorStop(0.5, 'rgb(255,10,10)');
  g.addColorStop(1.0, 'rgb(100,4,4)');
  ctx.globalAlpha = 1; ctx.fillStyle = '#280000'; ctx.fillRect(0, 0, cv.width, cv.height);
  ctx.fillStyle = g; ctx.globalAlpha = 1;
  ctx.fillRect(0, 0, cv.width, cv.height);
}

const renderers = {
  gray: renderGray, green: renderGreen, red: renderRed,
  yellow: renderYellow, yellowbusy: renderYellowbusy
};
function renderState(name, t) {
  (renderers[name] || renderGray)(t);
}

function draw(t) {
  // Polling ausschliesslich ueber requestAnimationFrame getaktet — setInterval
  // wird von SignalRGBs Renderer gedrosselt (empirisch erhaertet).
  if (t - lastPoll > POLL_MS) {
    lastPoll = t;
    poll();
  }

  const stale = (Date.now() - epochMs) > STALE_MS;
  const effective = stale ? 'gray' : state;

  const elapsed = performance.now() - changeAtMs;
  if (!stale && elapsed < FADE_MS && prevState !== effective) {
    renderState(prevState, t);
    ctx.globalAlpha = Math.min(1, elapsed / FADE_MS);
    renderState(effective, t);
    ctx.globalAlpha = 1;
  } else {
    renderState(effective, t);
  }

  requestAnimationFrame(draw);
}
requestAnimationFrame(draw);
</script>
</body>
</html>
